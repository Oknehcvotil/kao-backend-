PORT=5000
NODE_ENV=development

# Comma-separated frontend origins.
CORS_ORIGIN=http://localhost:5173,https://kao.delivery,https://www.kao.delivery

# SMTP account used to deliver form messages.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-user
SMTP_PASS=your-password
SMTP_FROM=KAO Delivery Website <no-reply@kao.delivery>
QUOTE_TO=office@kao.delivery

# Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
